{
  "expo": {
    "name": "Jozzo",
    "slug": "jozzo",
    "scheme": "jozzo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#181022",
    "ios": {
      "bundleIdentifier": "com.jozzo.app",
      "supportsTablet": false,
      "config": { "usesNonExemptEncryption": false },
      "infoPlist": {
        "CFBundleDevelopmentRegion": "fr",
        "CFBundleAllowMixedLocalizations": true,
        "WKAppBoundDomains": ["myjozzo.fr", "www.myjozzo.fr", "jgconnect.github.io"]
      }
    },
    "android": {
      "package": "com.jozzo.app",
      "adaptiveIcon": {
        "backgroundColor": "#181022",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      ["expo-splash-screen", { "image": "./assets/splash-icon.png", "imageWidth": 180, "backgroundColor": "#181022" }],
      "expo-web-browser"
    ]
  }
}
